# Environment Variables Template

# 1. PostgreSQL Connection String (Transaction Pooler port 6543)
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# 2. Supabase Project Base URL
VITE_SUPABASE_URL=https://<project_ref>.supabase.co

# 3. Supabase Public / Anon Publishable Key (Used by Frontend Client)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# 4. Supabase Secret / Service Role Key (Used by Admin Scripts & Edge Functions - Keep Private)
SUPABASE_SECRET_KEY=sb_secret_your_secret_service_role_key_here
